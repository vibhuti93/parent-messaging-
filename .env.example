# Runtime Configuration — Placeholders Only (Never commit real credentials)
# Messaging safety switches (Live messaging and deployment compliance must default to false)
LIVE_DISPATCH_ENABLED=false
# must stay false until docs/PRE_DEPLOYMENT_CHECKLIST.md is fully closed
DEPLOYMENT_COMPLIANCE_ACKNOWLEDGED=false
NETWORK_TTS_ENABLED=false

# WhatsApp Cloud API Configuration
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_ACCESS_TOKEN=placeholder_access_token_do_not_use
FACEBOOK_APP_SECRET=placeholder_app_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=placeholder_verify_token

# Parent Confirmation & QR Configuration
QR_CONFIRMATION_ENABLED=false
QR_TOKEN_TTL_HOURS=72
QR_HMAC_SECRET=placeholder_qr_secret_key

# Indian Carrier SMS / TRAI DLT Prerequisites (Deferred to pre-deployment checklist, see docs/PRE_DEPLOYMENT_CHECKLIST.md)
TRAI_DLT_PE_ID=placeholder_19_digit_pe_id
TRAI_DLT_TEMPLATE_ID=placeholder_dlt_template_id

# Data Retention Policy (Development defaults)
DATA_RETENTION_DAYS_LOGS=90
